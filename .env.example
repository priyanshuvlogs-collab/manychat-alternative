# ==============================================================================
# FlowFable — Environment Configuration
# Copy this file to `.env` and fill in the values.
# `docker compose up` reads this file automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=development

# Public URLs (used for OAuth callbacks, webhook registration, widget embeds)
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=flowfable
POSTGRES_PASSWORD=flowfable
POSTGRES_DB=flowfable
DATABASE_URL=postgresql://flowfable:flowfable@localhost:5432/flowfable?schema=public

# ------------------------------------------------------------------------------
# Redis (cache, pub/sub, BullMQ queues)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
# Secret for signing JWTs / session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-32-byte-secret
# Access token lifetime (seconds) and refresh token lifetime (seconds)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ------------------------------------------------------------------------------
# Encryption
# ------------------------------------------------------------------------------
# AES-256-GCM key for encrypting channel credentials & BYOK API keys at rest.
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=change-me-64-hex-characters

# ------------------------------------------------------------------------------
# Meta Platform (Instagram + Facebook Messenger + WhatsApp Cloud API)
# Create an app at https://developers.facebook.com
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Random string you choose; Meta echoes it back during webhook verification
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string

# ------------------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------------------
# Bots are connected per-workspace via BotFather tokens in the UI;
# this secret validates incoming webhook requests.
TELEGRAM_WEBHOOK_SECRET=change-me-random-string

# ------------------------------------------------------------------------------
# AI Providers (platform-level fallback keys — workspaces can BYOK in the UI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
# For local LLMs (Ollama, LM Studio, vLLM — any OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=

# Embeddings model used for the knowledge base (RAG)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Email (SMTP) — used for team invites & notifications.
# Defaults point at the bundled Mailpit instance for local development.
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FlowFable <no-reply@flowfable.local>"

# ------------------------------------------------------------------------------
# Storage (S3-compatible; used for media attachments)
# ------------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=flowfable-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Observability & limits
# ------------------------------------------------------------------------------
LOG_LEVEL=info
# Global API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120
